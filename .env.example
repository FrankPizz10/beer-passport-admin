# Firebase web config for the client (public values, no secrets)
REACT_APP_API_KEY=
REACT_APP_AUTH_DOMAIN=
REACT_APP_PROJECT_ID=
REACT_APP_STORAGE_BUCKET=
REACT_APP_MESSAGE_SENDER_ID=
REACT_APP_APP_ID=
REACT_APP_MEASUREMENT_ID=

# Admin API server base URL
REACT_APP_ADMIN_API_URL=http://localhost:4100

# Optional Firebase Auth emulator (local testing only)
REACT_APP_USE_AUTH_EMULATOR=false
REACT_APP_AUTH_EMULATOR_URL=http://localhost:9099
