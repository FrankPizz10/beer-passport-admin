// Read copy of the pilot server schema (beer-passport-server, prisma/schema.prisma).
// Source: ~/workspace/workstreams/pilot-impl/repo/prisma/schema.prisma
// This file is a read copy for Prisma client generation only. Do not edit models here.
// Run scripts/check-schema-drift.sh to verify it matches the pilot schema.
// BeerPassport PostgreSQL schema.
//
// This schema replaced the MySQL schema on 2026-10-27 (provider switch;
// decision 002 in the beer-passport-project hub). The port was made from
// the previous version of this file (master at 9b19504c, inventoried in
// the hub's research/db-schema-audit.md). Model and field names are
// unchanged so the generated Prisma client API stays identical.
//
// Changes versus the MySQL source, each tied to the schema audit:
// - Datasource provider: mysql -> postgresql. MySQL-only native types
//   (@db.Float) are dropped; Prisma Float maps to double precision.
// - F-2: beers.upc is String? (barcodes are identifiers, not quantities).
// - beers.discontinued added: the catalog cleanup's flag becomes a column.
// - F-7: beverage_images model added (image provenance for the relaunch).
// - F-5 (P0): destructive cascades removed. user_beers -> beers and
//   user_badges -> collections are now Restrict, so deleting a catalog beer
//   or a collection cannot wipe user history or earned badges. Cascades on
//   user deletion remain (account deletion should remove personal data).
// - F-4 (P0): api_keys.key is @unique with no empty-string default; name,
//   revoked, created_at, last_used_at added for rotation/revocation.
// - F-11: users gains created_at/updated_at. The @updatedAt fields also
//   carry @default(now()) so raw SQL loads (the EFS dump import, COPY
//   jobs) can insert rows without supplying them; the Prisma client
//   still maintains updated_at on its own writes.
// - F-13: redundant @unique on users.id removed.
// - F-9: styles.cat_id loses its magic @default(11); breweries.add_user is
//   nullable (0 meant "unknown" and now imports as NULL).
// - F-1 is enforced in the init migration SQL by a CHECK constraint
//   (user_1 < user_2) that Prisma cannot model; see prisma/migrations/.
// - The MySQL schema named both the breweries and collections unique
//   constraints "name"; Postgres index names are schema-global, so they are
//   renamed to "breweries_name" and "collections_name" here. Likewise, the
//   MySQL schema reused FK constraint names as index names; the Postgres
//   indexes carry an "_idx" suffix so both can coexist.
//
// Deferred to the Milestone 3 schema pass (audit P1/P2, documented in
// the hub's db/README.md): F-3 notifications uniqueness, F-6
// want-to-try state, F-8 breweries_geocode resolution, F-12
// multi-device push tokens.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model beers {
  id               Int                @id @default(autoincrement())
  brewery_id       Int?
  name             String             @default("") @db.VarChar(255)
  cat_id           Int?
  style_id         Int?
  abv              Float?
  ibu              Float?
  srm              Float?
  upc              String?            @db.VarChar(255)
  descript         String?            @db.Text
  // Weighted full-text search vector (beer name A, brewery name B, style
  // name C), added and populated by migration 20261121000001_discovery_search
  // for the discovery pilot. Maintained by that migration and, from
  // Milestone 2 on, by the import pipeline; not writable through Prisma.
  search_vector    Unsupported("tsvector")?
  discontinued     Boolean            @default(false)
  last_mod         DateTime           @default(now()) @db.Timestamp(0)
  brewery          breweries?         @relation(fields: [brewery_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_beers_brewery_id")
  category         categories?        @relation(fields: [cat_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_beers_cat_id")
  style            styles?            @relation(fields: [style_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_beers_style_id")
  beverage_images  beverage_images[]
  collection_beers collection_beers[]
  user_beers       user_beers[]
  discovery_matches discovery_candidates[] @relation("discovery_matched_beer")

  @@unique([brewery_id, name])
  @@index([brewery_id], map: "fk_beers_brewery_id_idx")
  @@index([cat_id], map: "fk_beers_cat_id_idx")
  @@index([style_id], map: "fk_beers_style_id_idx")
}

model beverage_images {
  id                  Int       @id @default(autoincrement())
  beverage_id         Int
  source_type         String    @default("") @db.VarChar(50)
  source_url          String    @default("") @db.VarChar(1024)
  storage_key         String    @default("") @db.VarChar(512)
  license_type        String    @default("") @db.VarChar(100)
  attribution         String    @default("") @db.VarChar(512)
  license_url         String    @default("") @db.VarChar(1024)
  status              String    @default("pending") @db.VarChar(20)
  verified_at         DateTime? @db.Timestamp(0)
  // Image approval workflow (migration 001 in server/db/migrations):
  // who decided this row's status and when, and the candidate loader's
  // check that a hosted storage_key URL really serves an image
  // (source_check_status: 'image' | 'not_image' | 'unreachable' |
  // 'unchecked'). Canonical change lives in beer-passport-server; see
  // server/db/migrations/001-image-approval.sql.
  reviewed_by         Int?
  reviewed_by_uid     String?   @db.VarChar(128)
  reviewed_at         DateTime? @db.Timestamp(0)
  source_content_type String?   @db.VarChar(100)
  source_checked_at   DateTime? @db.Timestamp(0)
  source_check_status String?   @db.VarChar(20)
  created_at          DateTime  @default(now()) @db.Timestamp(0)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamp(0)
  beers               beers     @relation(fields: [beverage_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_beverage_images_beer_id")
  reviewer            users?    @relation("beverage_images_reviewed_by", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_beverage_images_reviewed_by")
  review_events       image_review_events[]

  @@index([beverage_id], map: "fk_beverage_images_beer_id_idx")
  @@index([status], map: "beverage_images_status")
}

// Append-only audit trail for image approval decisions: one row per
// approve/reject, written in the same transaction as the status change
// by the beerpassport_admin_approver role. Created by migration 001 in
// server/db/migrations; canonical change lives in beer-passport-server.
model image_review_events {
  id                Int             @id @default(autoincrement())
  beverage_image_id Int
  beverage_id       Int
  action            String          @db.VarChar(10)
  from_status       String          @db.VarChar(20)
  to_status         String          @db.VarChar(20)
  admin_user_id     Int?
  admin_uid         String?         @db.VarChar(128)
  note              String?         @db.Text
  created_at        DateTime        @default(now()) @db.Timestamp(0)
  beverage_image    beverage_images @relation(fields: [beverage_image_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_image_review_events_image_id")
  admin_user        users?          @relation("image_review_events_admin_user", fields: [admin_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_image_review_events_admin_user_id")

  @@index([beverage_image_id], map: "image_review_events_beverage_image_id_idx")
}

// Catalog discovery hub staging (migration 002 in server/db/migrations;
// hub decision 006, issues/001). Fully separate from the catalog tables:
// candidates stay staged until a separately approved import. Image
// statuses are preserved exactly as staged and never promoted.
// Canonical change lives in beer-passport-server; see
// server/db/migrations/002-discovery-staging.sql.
model discovery_batches {
  id                Int      @id @default(autoincrement())
  slug              String   @unique @db.VarChar(120)
  title             String?  @db.VarChar(255)
  source            String   @db.VarChar(120)
  source_summary    String?  @db.Text
  manifest          Json
  bundle_sha256     String   @unique @db.VarChar(64)
  candidates_sha256 String   @db.VarChar(64)
  record_count      Int
  status            String   @default("staged") @db.VarChar(20)
  ingested_by       String?  @db.VarChar(120)
  ingested_at       DateTime @default(now()) @db.Timestamp(0)
  candidates        discovery_candidates[]
  pairs             discovery_candidate_pairs[]
}

model discovery_candidates {
  id                        Int       @id @default(autoincrement())
  batch_id                  Int
  candidate_key             String    @db.VarChar(320)
  payload                   Json
  name                      String    @db.VarChar(600)
  brewery_name              String?   @db.VarChar(600)
  style                     String?   @db.VarChar(255)
  abv                       Float?
  ibu                       Float?
  description               String?   @db.Text
  barcode                   String?   @db.VarChar(64)
  source                    String    @db.VarChar(120)
  source_record_id          String    @db.VarChar(320)
  source_url                String?   @db.Text
  retrieved_at              DateTime? @db.Timestamp(0)
  tier                      String?   @db.VarChar(20)
  origin_bucket             String?   @db.VarChar(30)
  origin_evidence           Json?
  image_url                 String?   @db.Text
  image_source              String?   @db.VarChar(120)
  image_tier                String?   @db.VarChar(20)
  image_status              String?   @db.VarChar(80)
  image_status_normalized   String?   @db.VarChar(30)
  image_verified            Boolean?
  image_flag_reason         String?   @db.Text
  image_license             String?   @db.VarChar(255)
  image_page_url            String?   @db.Text
  image_width               Int?
  image_height              Int?
  review_status             String    @default("pending") @db.VarChar(20)
  hold_reason               String?   @db.VarChar(40)
  hold_note                 String?   @db.Text
  dedupe_outcome            String    @default("not_checked") @db.VarChar(30)
  matched_beer_id           Int?
  duplicate_of_candidate_id Int?
  normalized_name           String    @db.VarChar(600)
  normalized_brewery        String?   @db.VarChar(600)
  created_at                DateTime  @default(now()) @db.Timestamp(0)
  updated_at                DateTime  @default(now()) @db.Timestamp(0)
  batch                     discovery_batches @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_discovery_candidates_batch_id")
  matched_beer              beers?    @relation("discovery_matched_beer", fields: [matched_beer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_discovery_candidates_matched_beer_id")
  duplicate_of              discovery_candidates?  @relation("discovery_duplicate_of", fields: [duplicate_of_candidate_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_discovery_candidates_duplicate_of")
  duplicates                discovery_candidates[] @relation("discovery_duplicate_of")
  pairs_as_candidate        discovery_candidate_pairs[] @relation("discovery_pairs_candidate")
  pairs_as_rival            discovery_candidate_pairs[] @relation("discovery_pairs_rival")

  @@unique([batch_id, candidate_key], map: "discovery_candidates_batch_key")
  @@index([batch_id], map: "discovery_candidates_batch_id_idx")
  @@index([origin_bucket], map: "discovery_candidates_origin_bucket_idx")
  @@index([hold_reason], map: "discovery_candidates_hold_reason_idx")
  @@index([review_status], map: "discovery_candidates_review_status_idx")
  @@index([barcode], map: "discovery_candidates_barcode_idx")
  @@index([normalized_name], map: "discovery_candidates_normalized_name_idx")
  @@index([image_status_normalized], map: "discovery_candidates_image_status_normalized_idx")
  @@index([source], map: "discovery_candidates_source_idx")
}

model discovery_candidate_pairs {
  id             Int       @id @default(autoincrement())
  batch_id       Int
  candidate_id   Int
  candidate_id_b Int?
  external_ref   String?   @db.VarChar(320)
  comparison     String?   @db.VarChar(120)
  method         String?   @db.VarChar(40)
  score          Float?
  status         String    @default("pending") @db.VarChar(20)
  decided_by     Int?
  decided_at     DateTime? @db.Timestamp(0)
  created_at     DateTime  @default(now()) @db.Timestamp(0)
  batch          discovery_batches    @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_discovery_pairs_batch_id")
  candidate      discovery_candidates @relation("discovery_pairs_candidate", fields: [candidate_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_discovery_pairs_candidate_id")
  rival          discovery_candidates? @relation("discovery_pairs_rival", fields: [candidate_id_b], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_discovery_pairs_candidate_id_b")
  decider        users?               @relation("discovery_pairs_decided_by", fields: [decided_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_discovery_pairs_decided_by")

  @@index([batch_id], map: "discovery_candidate_pairs_batch_id_idx")
  @@index([candidate_id], map: "discovery_candidate_pairs_candidate_id_idx")
  @@index([status], map: "discovery_candidate_pairs_status_idx")
}

model breweries {
  id       Int      @id @default(autoincrement())
  name     String   @default("") @db.VarChar(255)
  address1 String   @default("") @db.VarChar(255)
  address2 String   @default("") @db.VarChar(255)
  city     String   @default("") @db.VarChar(255)
  state    String   @default("") @db.VarChar(255)
  code     String   @default("") @db.VarChar(25)
  country  String   @default("") @db.VarChar(255)
  phone    String   @default("") @db.VarChar(50)
  website  String   @default("") @db.VarChar(255)
  descript String   @db.Text
  add_user Int?
  last_mod DateTime @default(now()) @db.Timestamp(0)
  beers    beers[]

  @@unique([name], map: "breweries_name")
}

model breweries_geocode {
  id         Int    @id @default(autoincrement())
  brewery_id Int    @default(0)
  latitude   Float  @default(0)
  longitude  Float  @default(0)
  accuracy   String @default("") @db.VarChar(255)
}

model categories {
  id       Int      @id @default(autoincrement())
  cat_name String   @default("") @db.VarChar(255)
  last_mod DateTime @default(now()) @db.Timestamp(0)
  beers    beers[]
  styles   styles[]

  @@unique([cat_name], map: "cat_name")
}

model styles {
  id         Int         @id @default(autoincrement())
  cat_id     Int?
  style_name String      @default("") @db.VarChar(255)
  last_mod   DateTime    @default(now()) @db.Timestamp(0)
  category   categories? @relation(fields: [cat_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_styles_cat_id")
  beers      beers[]

  @@unique([style_name], map: "style_name")
  @@index([cat_id], map: "fk_styles_cat_id_idx")
}

model user_beers {
  id         Int       @id @default(autoincrement())
  user_id    Int
  beer_id    Int
  liked      Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_beers_user_id")
  beers      beers     @relation(fields: [beer_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_user_beers_beer_id")

  @@unique([user_id, beer_id])
  @@index([beer_id], map: "fk_user_beers_beer_id_idx")
  @@index([user_id], map: "fk_user_beers_user_id_idx")
}

model users {
  id                            Int             @id @default(autoincrement())
  uid                           String          @unique(map: "uid") @db.VarChar(255)
  notification_token            String?         @unique @db.VarChar(255)
  age                           Int
  email                         String          @unique(map: "email") @db.VarChar(255)
  user_name                     String          @unique(map: "user_name") @db.VarChar(255)
  private                       Boolean         @default(false)
  created_at                    DateTime        @default(now()) @db.Timestamp(0)
  updated_at                    DateTime        @default(now()) @updatedAt @db.Timestamp(0)
  friends_friends_user_1Tousers friends[]       @relation("friends_user_1Tousers")
  friends_friends_user_2Tousers friends[]       @relation("friends_user_2Tousers")
  user_badges                   user_badges[]
  user_beers                    user_beers[]
  notifications                 notifications[]
  beverage_images_reviewed      beverage_images[]   @relation("beverage_images_reviewed_by")
  image_review_events           image_review_events[] @relation("image_review_events_admin_user")
  discovery_pairs_decided       discovery_candidate_pairs[] @relation("discovery_pairs_decided_by")
}

model collections {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(255)
  difficulty       Int
  description      String             @db.VarChar(255)
  created_at       DateTime?          @default(now()) @db.Timestamp(0)
  updated_at       DateTime?          @default(now()) @db.Timestamp(0)
  collection_beers collection_beers[]
  user_badges      user_badges[]

  @@unique([name], map: "collections_name")
}

model user_badges {
  id            Int         @id @default(autoincrement())
  user_id       Int
  collection_id Int
  earned        Boolean     @default(false)
  progress      Float       @default(0)
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  updated_at    DateTime    @default(now()) @db.Timestamp(0)
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_badges_user_id")
  collections   collections @relation(fields: [collection_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_user_badges_collection_id")

  @@unique([user_id, collection_id], map: "user_id_collection_id")
  @@index([collection_id], map: "collection_id")
}

model collection_beers {
  id            Int         @id @default(autoincrement())
  collection_id Int
  beer_id       Int
  created_at    DateTime?   @default(now()) @db.Timestamp(0)
  updated_at    DateTime?   @default(now()) @db.Timestamp(0)
  collections   collections @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_collection_id")
  beers         beers       @relation(fields: [beer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_beer_id")

  @@unique([collection_id, beer_id], map: "collection_id_beer_id")
  @@index([beer_id], map: "beer_id")
}

model friends {
  id                          Int      @id @default(autoincrement())
  user_1                      Int
  user_2                      Int
  created_at                  DateTime @default(now()) @db.Timestamp(0)
  updated_at                  DateTime @default(now()) @db.Timestamp(0)
  users_friends_user_1Tousers users    @relation("friends_user_1Tousers", fields: [user_1], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "friends_ibfk_1")
  users_friends_user_2Tousers users    @relation("friends_user_2Tousers", fields: [user_2], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "friends_ibfk_2")

  @@unique([user_1, user_2], map: "unique_user_combination")
  @@index([user_2], map: "user_2")
}

model notifications {
  id         Int              @id @default(autoincrement())
  user_id    Int
  type       NotificationType
  message    String           @db.VarChar(255)
  created_at DateTime         @default(now()) @db.Timestamp(0)
  updated_at DateTime         @default(now()) @db.Timestamp(0)
  viewed     Boolean          @default(false)
  users      users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notifications_user_id")

  @@unique([user_id, message], map: "unique_user_id_message")
  @@index([user_id], map: "fk_notifications_user_id_idx")
}

enum NotificationType {
  NEW_FRIEND
  BADGE_EARNED
}

model api_keys {
  id           Int       @id @default(autoincrement())
  key          String    @unique @db.VarChar(255)
  name         String    @default("") @db.VarChar(255)
  revoked      Boolean   @default(false)
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  last_used_at DateTime? @db.Timestamp(0)
  last_mod     DateTime  @default(now()) @db.Timestamp(0)
}
