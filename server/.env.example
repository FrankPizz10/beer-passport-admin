# Copy to .env for local development. Never commit a real .env.
# Local database (PostgreSQL on 127.0.0.1:54329, database beerpassport_dev).
# The psql helper at ~/workspace/workstreams/db-recovery/run/psql.sh connects
# with user postgres and no password, so this URL works locally:
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/beerpassport_dev
# Image approval write path (server only). This is the ONLY write
# connection the API has: it must be the beerpassport_admin_approver
# role (server/db/approval-role.sql), which can update only the
# decision columns of beverage_images and insert/select
# image_review_events. Never the migration/owner identity, and never
# the viewer role's URL. Leave UNSET to disable the approval endpoints
# entirely: they answer 503 and the rest of the viewer is unaffected.
# DATABASE_URL_WRITE=postgresql://beerpassport_admin_approver:CHANGE_ME@localhost:54329/beerpassport_dev
PORT=4100
ADMIN_ORIGIN=http://localhost:3000
# Firebase Admin (server only). Leave all of these unset for local work
# without Firebase: the server still boots, token verification reports a
# distinct not configured error, and /admin/accounts degrades gracefully.
# FIREBASE_TYPE=service_account
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_CLIENT_ID=
# FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
# FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# FIREBASE_CLIENT_X509_CERT_URL=
# FIREBASE_UNIVERSE_DOMAIN=googleapis.com
# Or use the Firebase Auth emulator instead:
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Private image storage (release 1.0 presigned image endpoint). Leave
# unset to disable the endpoint (it answers 500; the rest of the viewer
# is unaffected). The signing identity must hold s3:GetObject only;
# credentials resolve through the AWS SDK default chain (environment
# variables or an instance/task role), never from a committed file.
# ADMIN_IMAGE_BUCKET=
# ADMIN_IMAGE_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
