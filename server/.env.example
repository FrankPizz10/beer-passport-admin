# Copy to .env for local development. Never commit a real .env.
# Local database (PostgreSQL on 127.0.0.1:54329, database beerpassport_dev).
# The psql helper at ~/workspace/workstreams/db-recovery/run/psql.sh connects
# with user postgres and no password, so this URL works locally:
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/beerpassport_dev
PORT=4100
ADMIN_ORIGIN=http://localhost:3000
# Firebase Admin (server only). Leave all of these unset for local work
# without Firebase: the server still boots, token verification reports a
# distinct not configured error, and /admin/accounts degrades gracefully.
# FIREBASE_TYPE=service_account
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_CLIENT_ID=
# FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
# FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# FIREBASE_CLIENT_X509_CERT_URL=
# FIREBASE_UNIVERSE_DOMAIN=googleapis.com
# Or use the Firebase Auth emulator instead:
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
